\#*\#
*.elc
.\#*

/.DS_Store
# Emacs config is emacs/ (authored only); ./init symlinks it into a REAL
# ~/.emacs.d and nothing under .emacs.d is tracked. This line only hides the
# leftover .emacs.d/ on a host that pulled but has not run ./init yet (init
# moves it out). Anchored because this file is also core.excludesfile (see
# .gitconfig) and is read by every repo.
/.emacs.d/
/.gitconfig-meta
/.claude
/.sisyphus
/tmp
**/.claude/settings.local.json
**/.omo
