#!/bin/bash
# Sync this machine's Emacs packages with the package lists.
#
#   emacs-bootstrap            install what the lists name, remove what they dropped
#   emacs-bootstrap --dry-run  print what would be installed/removed, change nothing
#   emacs-bootstrap --upgrade  sync, then upgrade everything installed
#
# ./init runs this, so `git pull && ./init` is the whole sync.
#
# The lists: emacs/packages.el (shared) + ~/.emacs.d/packages-local.el (this
# machine, linked to host/<host>/emacs/), written by M-x list-packages - see
# emacs/lisp/my-packages.el. Dependencies are never listed; package.el keeps
# what the listed packages need and removes what nothing needs any more.
#
# Safety: if either list is unreadable (e.g. git conflict markers) this exits 1
# having changed nothing; it never removes anything when the lists are empty.
# With nothing to install it makes no network calls. After syncing it loads
# init.el exactly as a real start would, so it also proves init loads.
#
# Env: EMACS (binary, default `emacs'; scripts never see the emacsclient alias
# in .bashrc), EMACS_DIR (default ~/.emacs.d).

set -eo pipefail

usage() {
	sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-0}"
}

mode=sync
case "${1:-}" in
	"") ;;
	--dry-run) mode=dry-run ;;
	--upgrade) mode=upgrade ;;
	-h|--help) usage 0 ;;
	*) echo "unknown argument: $1" >&2; usage 2 >&2 ;;
esac

emacs_bin="${EMACS:-emacs}"
dir="${EMACS_DIR:-$HOME/.emacs.d}"

for f in early-init.el init.el lisp/my-packages.el; do
	if [[ ! -e "$dir/$f" ]]; then
		echo "emacs-bootstrap: $dir/$f is missing - run ./init from the dotfiles repo first" >&2
		exit 1
	fi
done

read -r -d '' ELISP <<'EOF' || true
(progn
  (require 'package)
  (require 'cl-lib)
  (package-initialize)
  (add-to-list 'load-path (locate-user-emacs-file "lisp"))
  (require 'my-packages)
  (my/packages-load)

  (defun bootstrap--names (descs)
    (mapconcat (lambda (d) (symbol-name (package-desc-name d))) descs " "))

  (unless my/packages-read-ok
    (message "emacs-bootstrap: FAILED - a package list is unreadable (see above); nothing changed")
    (kill-emacs 1))

  (let* ((selected package-selected-packages)
         (missing (cl-remove-if #'package-installed-p selected))
         installed failed removed)
    (message "emacs-bootstrap: %d listed (%d shared, %d this machine), %d to install"
             (length selected) (length my/packages-shared) (length my/packages-local)
             (length missing))

    (when (eq bootstrap-mode 'dry-run)
      (message "emacs-bootstrap: would install: %s"
               (if missing (mapconcat #'symbol-name missing " ") "(nothing)"))
      (message "emacs-bootstrap: would remove:  %s"
               (if (null selected)
                   "(nothing - lists are empty, refusing)"
                 (let ((r (package--removable-packages)))
                   (if r (bootstrap--names r) "(nothing)"))))
      (kill-emacs 0))

    ;; Refresh first: a stale cached index can name a version the archive no
    ;; longer serves, and that download 404s.
    (when (or missing (eq bootstrap-mode 'upgrade))
      (package-refresh-contents))

    ;; DONT-SELECT: installing what the lists already name must not rewrite them.
    (dolist (p missing)
      (condition-case err
          (progn (package-install p t) (push p installed))
        (error (push p failed)
               (message "emacs-bootstrap: failed to install %s: %s"
                        p (error-message-string err)))))

    ;; Removal: whatever is neither listed nor needed by something listed.
    ;; Computed after installing, so new dependencies count as needed.
    (if (null selected)
        (message "emacs-bootstrap: lists are empty - refusing to remove anything")
      (dolist (desc (package--removable-packages))
        (condition-case err
            (progn (package-delete desc t t) (push (package-desc-name desc) removed))
          (error (message "emacs-bootstrap: failed to remove %s: %s"
                          (package-desc-name desc) (error-message-string err))))))

    (when (eq bootstrap-mode 'upgrade)
      (package-upgrade-all nil))

    ;; Prove init loads, and report config blocks that were skipped.
    (condition-case err
        (load (locate-user-emacs-file "init.el") nil 'nomessage)
      (error (message "emacs-bootstrap: init.el failed to load: %s"
                      (error-message-string err))
             (kill-emacs 1)))
    (my/package-report)

    (message "emacs-bootstrap: installed: %s"
             (if installed (mapconcat #'symbol-name (nreverse installed) " ") "-"))
    (message "emacs-bootstrap: removed:   %s"
             (if removed (mapconcat #'symbol-name (nreverse removed) " ") "-"))
    (if failed
        (progn (message "emacs-bootstrap: FAILED, not installed: %s"
                        (mapconcat #'symbol-name failed " "))
               (kill-emacs 1))
      (message "emacs-bootstrap: OK"))))
EOF

exec "$emacs_bin" --batch --init-directory="$dir" \
	-l "$dir/early-init.el" \
	--eval "(defvar bootstrap-mode '$mode)" \
	--eval "$ELISP"
