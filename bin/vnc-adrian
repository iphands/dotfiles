#!/bin/bash
set -e

# Adrian's labwc session lives on seat1 of cosmo, so wayvnc runs here as merozas
ssh merozas@cosmo.lan 'XDG_RUNTIME_DIR=/run/user/1001 WAYLAND_DISPLAY=wayland-0 wayvnc -e -Ldebug 127.0.0.1' &
trap "ssh merozas@cosmo.lan 'killall -q wayvnc' || true" EXIT

# wait up to 5s for wayvnc to listen (don't probe with a connect, -e would exit on the disconnect)
for _ in $(seq 50); do
  [ -n "$(ss -Hltn 'sport = :5900')" ] && break
  sleep 0.1
done

vncviewer 127.0.0.1 -CompressLevel 0 -CustomCompressLevel 1 -QualityLevel 0 -AutoSelect 1
