#!/bin/bash
# brightness up|down|kbd-up|kbd-down|kbd-cycle
# Screen steps get finer as brightness approaches 0, and never hit 0 (black)

DEV=""
[[ -e /sys/class/backlight/apple-panel-bl ]] && DEV="-d apple-panel-bl"

# Bands are raw values, so the bottom of the range isn't quantized by the
# percent granularity (max_brightness 400 means 1% is already 4 raw units).
#
#   raw <= 10   step 1 raw
#   raw 11-20   step 5 raw
#   raw >  20   step 10%

MIN=1
FINE=10
MID=20

function raw() {
    brightnessctl $DEV -m | cut -d, -f3
}

function max() {
    brightnessctl $DEV -m | cut -d, -f5
}

function step() {
    local cur=$1
    local max=$2
    local s
    if   (( cur > MID  )); then s=$(( max * 10 / 100 ))
    elif (( cur > FINE )); then s=5
    else                        s=1
    fi
    (( s < 1 )) && s=1
    echo $s
}

function set_raw() {
    local new=$1
    local max=$2
    (( new > max )) && new=$max
    (( new < MIN )) && new=$MIN
    brightnessctl -q $DEV set $new
}

# Snap to the next/previous multiple of the step.
function up() {
    local m=`max`
    local c=`raw`
    local s=`step $c $m`
    set_raw $(( (c / s + 1) * s )) $m
}

# The 10% step is bigger than the whole fine range, so a step down out of the
# coarse band lands on the band boundary rather than leaping over it.
function down() {
    local m=`max`
    local c=`raw`
    local s=`step $c $m`
    (( c <= MIN )) && return 0

    local new=$(( ((c - 1) / s) * s ))
    if   (( c > MID  && new < MID  )); then new=$MID
    elif (( c > FINE && new < FINE )); then new=$FINE
    fi

    set_raw $new $m
}

case $1 in
    up)       up ;;
    down)     down ;;
    kbd-up)   brightnessctl -q -d kbd_backlight set 10%+ ;;
    kbd-down) brightnessctl -q -d kbd_backlight set 10%- ;;
    kbd-cycle)
        levels=(0 1 5 10 51 100)
        cur=$(brightnessctl -d kbd_backlight get)
        next=0
        for l in "${levels[@]}"; do
            (( l > cur )) && { next=$l; break; }
        done
        brightnessctl -q -d kbd_backlight set "$next" ;;
    *) echo "usage: $0 up|down|kbd-up|kbd-down|kbd-cycle" >&2; exit 1 ;;
esac
