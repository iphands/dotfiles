#!/bin/bash
set -e

current="$HOME/.dotfiles_backup/`date +%Y%m%d%H%M%S`"
mkdir -p "$current"

host=unknown
[[ "$HOSTNAME" =~ "PC2K41CN" ]] && host=handslap
[[ "$HOSTNAME" =~ "PF5KC9XD" ]] && host=handslap
[[ "$HOSTNAME" =~ "PF5ZVWY8" ]] && host=handslap
[[ "$HOSTNAME" =~ "cosmo" ]] && host=cosmo
[[ "$HOSTNAME" =~ "station" ]] && host=station
[[ "$HOSTNAME" == "ahands.org" ]] && host=ahands
[[ "$HOSTNAME" == "handsair" ]] && host=handsair

echo
echo "## Found host: $host"

install_scripts() {
  p=$1
  echo
  echo "## $p scripts"
  mkdir -p ~/$p
  pushd ./$p >/dev/null
  for var in *
  do
    echo "-- installing ~/$p/$var"
    ln -sf $PWD/$var ~/$p/
  done
  popd >/dev/null
}

install_host() {
  git_target=$1
  target=$2
  [[ "$host" == "unknown" ]] && return 0
  [[ -d host/$host/$git_target ]] || return 0

  pushd host/$host/$git_target >/dev/null
  mkdir -p $target
  for var in *
  do
    echo "-- installing $target/$var"
    ln -nfs $PWD/$var $target/$var
  done
  popd >/dev/null
}

install_systemd() {
  pushd systemd-user
  target=".config/systemd/user"
  mkdir -p "${HOME}/$target"
  for var in *
  do
    echo "-- installing ~/$target/$var"
    ln -nfs $PWD/$var ~/$target/$var
  done
  popd
}

# ~/.emacs.d is a REAL local directory owned by Emacs (elpa/, eln-cache/,
# history, custom.el). Only the authored files are links into emacs/ here, so
# nothing Emacs writes can land in this worktree. Packages come from the
# network: run emacs-bootstrap.
install_emacs() {
  echo
  echo "## Emacs"
  local d="$HOME/.emacs.d"

  # Emacs reads ~/.emacs INSTEAD OF ~/.emacs.d/init.el when it exists, so
  # ~/.emacs is a signpost (emacs/dot-emacs.el): comments on where everything
  # is and how to use it, plus one line that loads ~/.emacs.d/init.el.
  # Anything else there (a real file, the legacy link) would shadow the config.
  if [[ ( -e ~/.emacs || -L ~/.emacs ) && "$(readlink ~/.emacs)" != "$PWD/emacs/dot-emacs.el" ]]; then
    echo "-- moving old ~/.emacs to $current/ (replaced by the signpost)"
    mv ~/.emacs "$current/"
  fi
  echo "-- installing ~/.emacs -> emacs/dot-emacs.el (signpost; loads ~/.emacs.d/init.el)"
  ln -sfn "$PWD/emacs/dot-emacs.el" ~/.emacs

  # Legacy layout: ~/.emacs.d -> this repo's .emacs.d, which made the worktree
  # Emacs's state directory.
  if [[ -L "$d" ]]; then
    local old
    old="$(readlink -f "$d")"
    if [[ "$old" != "$PWD/.emacs.d" ]]; then
      echo "-- WARNING: ~/.emacs.d is a symlink to $old (not this repo); leaving it alone, emacs not installed"
      return 0
    fi
    echo "-- replacing legacy ~/.emacs.d symlink with a real directory"
    rm "$d"
    mkdir -p "$d"
    # Carry over local state (history, recentf, smex, tramp, ...). Not elpa:
    # emacs-bootstrap rebuilds it from the declared list.
    local f
    shopt -s nullglob dotglob
    for f in "$old"/*; do
      case "${f##*/}" in
        elpa|auto-save-list|eln-cache|.gitignore|.emacs|.#*|*~) continue ;;
      esac
      echo "-- carrying over ${f##*/}"
      cp -a "$f" "$d/"
    done
    shopt -u nullglob dotglob
    local legacy
    legacy="$HOME/.emacs.d.legacy-$(date +%Y%m%d%H%M%S)"
    echo "-- old directory (incl. elpa) kept at $legacy"
    mv "$old" "$legacy"
  fi

  mkdir -p "$d"
  local var
  for var in early-init.el init.el lisp; do
    [[ -e "$PWD/emacs/$var" ]] || continue
    if [[ -e "$d/$var" && ! -L "$d/$var" ]]; then
      mv "$d/$var" "$current/"
    fi
    echo "-- installing ~/.emacs.d/$var"
    ln -sfn "$PWD/emacs/$var" "$d/$var"
  done

  # This machine's extra packages, tracked per host. The link may dangle until
  # the first M-x my/package-make-local creates the file. Unknown host: it
  # stays a plain local file.
  if [[ "$host" != "unknown" ]]; then
    local mine="$PWD/host/$host/emacs/packages-local.el"
    local link="$d/packages-local.el"
    if [[ -e "$link" && ! -L "$link" ]]; then
      if [[ -e "$mine" ]]; then
        echo "-- WARNING: both $link and $mine exist; keeping the tracked one, old local list saved to $current/"
        mv "$link" "$current/"
      else
        echo "-- moving local package list into host/$host/emacs/ (commit it)"
        mkdir -p "${mine%/*}"
        mv "$link" "$mine"
      fi
    fi
    echo "-- installing ~/.emacs.d/packages-local.el -> host/$host/emacs/packages-local.el"
    ln -sfn "$mine" "$link"
  fi

  # Sync packages with the lists (install new, remove dropped). Never fatal:
  # init must still finish offline or on a host without Emacs.
  if [[ "${EMACS_BOOTSTRAP:-1}" == "0" ]]; then
    echo "-- EMACS_BOOTSTRAP=0: skipping package sync"
  elif [[ "$EUID" -eq 0 ]]; then
    echo "-- running as root: skipping package sync"
  elif ! command -v emacs >/dev/null 2>&1; then
    echo "-- no emacs binary: skipping package sync"
  elif ! emacs --batch --eval '(kill-emacs (if (>= emacs-major-version 30) 0 1))' 2>/dev/null; then
    echo "-- emacs is older than 30: skipping package sync"
  else
    local log="$current/emacs-bootstrap.log" rc=0
    echo "-- syncing packages (emacs-bootstrap; a fresh machine downloads ~60, about a minute)"
    "$PWD/bin/emacs-bootstrap" >"$log" 2>&1 || rc=$?
    grep -E '^emacs-bootstrap:|^(Warning|Error) \(my-packages\)' "$log" | sed 's/^/   /' || true
    if [[ "$rc" -ne 0 ]]; then
      echo "-- WARNING: emacs-bootstrap failed (offline? merge conflict in a package list?)"
      echo "--          full log: $log - fix, then rerun ./init or emacs-bootstrap"
    fi
  fi
}

echo "## Dotfiles"
for var in ".Xdefaults"\
  ".alacritty.toml" \
  ".bash_profile" \
  ".bashrc" \
  ".gitconfig" \
  ".gitconfig-meta" \
  ".gitignore" \
  ".tmux.conf" \
  ".tmux.conf.local"
do
  echo "-- installing $var"
  if [[ -f ~/${var} ]]
  then
    cp -HR ~/${var} "$current"
  fi
  ln -sf "$PWD/${var}" ~/
done

install_emacs

install_scripts bin

if [ "$EUID" -eq 0 ]
then
  install_scripts sbin
fi

echo
echo "## Host specific"
install_host fluxbox "${HOME}/.fluxbox"
install_host labwc   "${HOME}/.config/labwc"
install_host waybar  "${HOME}/.config/waybar"
install_host fail2ban/jail    /etc/fail2ban/jail.d
install_host fail2ban/filter /etc/fail2ban/filter.d

echo
echo "## Install sytemd"
install_systemd

echo
echo "## Install themes"
rm -rf ~/.themes 2>&1 >/dev/null || true
ln -vnfs "${PWD}/themes" ~/.themes

