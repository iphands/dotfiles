#!/bin/bash
# Guards the Emacs layout: authored config is tracked under emacs/, and nothing
# under .emacs.d is tracked, ever.
#
# ./init makes ~/.emacs.d a REAL local directory and symlinks emacs/init.el,
# emacs/early-init.el (and emacs/lisp, if it exists) into it. Packages are
# declared with use-package in emacs/init.el and fetched from the network by
# bin/emacs-bootstrap; elpa/, caches and history never touch this worktree.
#
# Every assertion is a plain git or grep query, so this runs on any host and in
# a container with no Emacs. The Emacs-dependent end-to-end check (fresh HOME,
# real downloads) is tests/emacs-smoke. Nothing runs this automatically; run it
# by hand:  tests/emacs-test
#
# Canonical clone: ~/prog/dotfiles

set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

source "$SCRIPT_DIR/ban-test-lib/lib/test-helpers.sh"

cd "$PROJECT_ROOT" || exit 1

# core.quotePath=false: git C-quotes non-ASCII paths, and a quoted path can
# never equal an unquoted expectation.
ls_files() {
	git -c core.quotePath=false ls-files "$@"
}

# ---------------------------------------------------------------------------
# Positive controls. Without these, "found no offenders" is equally consistent
# with "the invariant holds" and "the query matched nothing at all".
# ---------------------------------------------------------------------------

test_running_against_repo_root() {
	assert_equals "$(git rev-parse --show-toplevel)" "$PROJECT_ROOT" \
		"suite is running against its own repo root, not a stray clone"
}

test_authored_files_are_tracked() {
	local f
	for f in emacs/init.el emacs/early-init.el bin/emacs-bootstrap; do
		assert_not_empty "$(ls_files -- "$f")" "$f is tracked" || return 1
	done
	assert_equals "$(git ls-files -s -- bin/emacs-bootstrap | cut -d' ' -f1)" "100755" \
		"bin/emacs-bootstrap is tracked executable (./init links bin/* onto PATH)"
}

# ---------------------------------------------------------------------------
# The load-bearing invariants.
# ---------------------------------------------------------------------------

test_nothing_tracked_under_dot_emacs_d() {
	assert_empty "$(ls_files -- .emacs.d | head -5)" \
		"nothing is tracked under .emacs.d/ (packages come from emacs-bootstrap, state stays local)"
}

test_dot_emacs_d_is_ignored_by_root_rule() {
	local src
	src=$(git check-ignore -v --no-index -- .emacs.d/elpa/foo-1.0/foo.el || true)
	assert_contains "$src" ".gitignore:" \
		".emacs.d/ leftovers are ignored (got: ${src:-not ignored})" || return 1
	assert_contains "$src" "/.emacs.d/" \
		"...and by the anchored /.emacs.d/ rule, not some unrelated pattern"
}

test_emacs_dir_is_elisp_only() {
	local offenders
	offenders=$(ls_files -- emacs | grep -v '\.el$' | grep -vx 'emacs/README\.md' || true)
	assert_empty "$offenders" "everything tracked under emacs/ is a .el file (or emacs/README.md)"
}

test_no_generated_elisp_tracked_anywhere() {
	local offenders
	offenders=$(ls_files | grep -E '\.(elc|eln)$|(^|/)custom\.el$|(^|/)elpa/' || true)
	assert_empty "$offenders" \
		"no .elc/.eln, custom.el or elpa/ tracked anywhere in the repo"
}

test_no_symlinks_under_emacs() {
	local links
	links=$(git ls-files -s -- emacs | awk '$1 == "120000" {print $4}')
	assert_empty "$links" \
		"no symlinks tracked under emacs/ (./init makes the links, the repo holds the files)"
}

# The old layout symlinked the whole of .emacs.d (and .emacs) from the dotfile
# loop, which is what made the worktree Emacs's state dir.
test_init_does_not_link_emacs_wholesale() {
	local loop
	loop=$(sed -n '/^for var in "\.Xdefaults"/,/^do$/p' init)
	assert_not_empty "$loop" "positive control: found the dotfile loop in ./init" || return 1
	assert_empty "$(grep -F '".emacs' <<<"$loop" || true)" \
		"./init's dotfile loop does not link .emacs or .emacs.d" || return 1
	assert_not_empty "$(grep -x 'install_emacs' init || true)" \
		"./init calls install_emacs"
}

test_packages_are_declared_not_customized() {
	assert_not_empty "$(grep -E '^\(setq use-package-always-ensure t' emacs/init.el || true)" \
		"emacs/init.el sets use-package-always-ensure (that is what installs packages)" || return 1
	assert_not_empty "$(grep -E '^\(setq custom-file ' emacs/init.el || true)" \
		"emacs/init.el sends Customize to a local custom-file" || return 1
	# Code only: init.el's comments explain this very rule by name.
	assert_empty "$(grep -nE '^[^;]*package-selected-packages' emacs/init.el || true)" \
		"emacs/init.el has no package-selected-packages (package.el rewrites it on every install)"
}

test_archives_are_https() {
	assert_not_empty "$(grep -E '"https://melpa\.org/packages/"' emacs/early-init.el || true)" \
		"positive control: MELPA is configured in emacs/early-init.el" || return 1
	assert_empty "$(grep -nE '"http://' emacs/early-init.el emacs/init.el || true)" \
		"no plain-http package archive (MELPA packages are unsigned)"
}

main_test() {
	local rc=0

	echo "========================================"
	echo "Emacs layout guard"
	echo "========================================"

	# `|| rc=1`, never `|| true`: with `|| true` a test that dies early leaves
	# TESTS_FAILED at 0 and the suite reports green. This form catches both an
	# assert failure and an early death, and still reaches print_test_summary.
	run_test "Positive controls" test_running_against_repo_root || rc=1
	run_test "Positive controls" test_authored_files_are_tracked || rc=1
	run_test "Invariants" test_nothing_tracked_under_dot_emacs_d || rc=1
	run_test "Invariants" test_dot_emacs_d_is_ignored_by_root_rule || rc=1
	run_test "Invariants" test_emacs_dir_is_elisp_only || rc=1
	run_test "Invariants" test_no_generated_elisp_tracked_anywhere || rc=1
	run_test "Invariants" test_no_symlinks_under_emacs || rc=1
	run_test "Install" test_init_does_not_link_emacs_wholesale || rc=1
	run_test "Packages" test_packages_are_declared_not_customized || rc=1
	run_test "Packages" test_archives_are_https || rc=1

	print_test_summary || rc=1
	return $rc
}

main_test
